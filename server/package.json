{
  "name": "kids-clothing-server",
  "version": "1.0.0",
  "description": "Backend API for Kids Clothing E-Commerce",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:test": "tsx src/db/testConnection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "test:phase2": "tsx src/test_apis.ts",
    "test:auth": "tsx src/test_auth.ts",
    "test:phase4": "tsx src/test_phase4.ts",
    "test:phase5": "tsx src/test_phase5.ts",
    "test:phase6": "tsx src/test_phase6.ts",
    "test:all": "tsx src/test_phase6.ts && tsx src/test_phase5.ts && tsx src/test_phase4.ts && tsx src/test_auth.ts && tsx src/test_apis.ts"
  },
  "keywords": [
    "ecommerce",
    "express",
    "typescript",
    "drizzle-orm",
    "neon-postgres",
    "auth"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "razorpay": "^2.9.8",
    "resend": "^6.26.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
