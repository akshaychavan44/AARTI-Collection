# ==============================================================================
# Kalyan Kids E-Commerce Platform - Environment Configuration Template
# For local dev, copy this to .env (ignored by git).
# For Vercel, copy these keys and values into Vercel Project Settings > Environment Variables.
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Neon PostgreSQL serverless HTTP connection string)
DATABASE_URL=postgresql://neondb_owner:npg_YOUR_PASSWORD@ep-cool-cloud-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Frontend URL (leave as your Vercel deployment URL or localhost)
FRONTEND_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_API_URL=/api

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_jwt_key_kalyan_kids_2026_auth_system_replace_in_prod
JWT_EXPIRES_IN=7d

# Razorpay Test / Production Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Resend Transactional Email API (Optional)
RESEND_API_KEY=re_placeholder_api_key
RESEND_FROM_EMAIL=orders@kalyankids.com
